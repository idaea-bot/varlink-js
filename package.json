{
  "name": "varlink-js",
  "version": "1.0.0-alpha.0",
  "description": "Varlink (UAPI.20) client, server, IDL tools and CLI for JavaScript runtimes",
  "author": "Pawel Zmarzly <pawo2500@gmail.com>",
  "keywords": [
    "varlink",
    "ipc",
    "rpc",
    "systemd"
  ],
  "homepage": "https://github.com/pzmarzly/varlink-js",
  "bugs": {
    "url": "https://github.com/pzmarzly/varlink-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pzmarzly/varlink-js.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18",
      "onFail": "error"
    }
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./websocket": {
      "types": "./dist/websocket/index.d.ts",
      "default": "./dist/websocket/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./idl": {
      "types": "./dist/idl/index.d.ts",
      "default": "./dist/idl/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "default": "./dist/codegen/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "varlink-js": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint --max-warnings=0 . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json",
    "test": "node --test \"test/**/*.test.ts\" \"src/**/*.test.ts\"",
    "clean": "node -e \"for (const d of ['dist', 'build', 'pkg']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.json --noEmit false --outDir build",
    "test:consumer": "node test/fixtures/consumer/run.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
